{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "land": {
      "type": "string",
      "minLength": 1
    },
    "myths": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "symbol_meaning",
              "value",
              "opposition",
              "prohibition",
              "obligation",
              "custom",
              "saying",
              "person",
              "place",
              "fact"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "myth"
                  },
                  "mythId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "mythId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "gloss"
                  }
                },
                "required": [
                  "type"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "consult"
                  },
                  "by": {
                    "type": "string",
                    "enum": [
                      "shaman",
                      "spirits"
                    ]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "askedBy": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "type",
                  "by",
                  "question",
                  "askedBy"
                ],
                "additionalProperties": false
              }
            ]
          },
          "say": {
            "type": "string",
            "enum": [
              "anyone",
              "earned",
              "shown"
            ]
          },
          "variation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "topic",
          "statement",
          "origin",
          "say"
        ],
        "additionalProperties": false
      }
    },
    "customs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "visible": {
            "type": "string",
            "minLength": 1
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "visible",
          "reasons"
        ],
        "additionalProperties": false
      }
    },
    "villagers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "age": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "temperament": {
            "type": "string",
            "minLength": 1
          },
          "pronoun": {
            "type": "string",
            "enum": [
              "she",
              "he",
              "they"
            ]
          },
          "doubts": {
            "type": "boolean"
          },
          "knowsEntries": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "knowsMyths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "mythId": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "mythId"
              ],
              "additionalProperties": false
            }
          },
          "slant": {
            "type": "string",
            "minLength": 1
          },
          "lines": {
            "type": "object",
            "properties": {
              "refusal": {
                "type": "string",
                "minLength": 1
              },
              "withholding": {
                "type": "string",
                "minLength": 1
              },
              "redirect": {
                "type": "string",
                "pattern": "\\{name\\}"
              }
            },
            "required": [
              "refusal",
              "withholding",
              "redirect"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "age",
          "temperament",
          "pronoun",
          "doubts",
          "knowsEntries",
          "knowsMyths",
          "slant",
          "lines"
        ],
        "additionalProperties": false
      }
    },
    "heart": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "silences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "language",
    "land",
    "myths",
    "entries",
    "customs",
    "villagers",
    "heart",
    "silences"
  ],
  "additionalProperties": false,
  "$id": "https://fieldwork.invalid/schemas/culture.schema.json",
  "title": "Fieldwork culture",
  "description": "An invented culture: its myths, what is true in it, its customs and its people. This schema checks shape only. The parser in @fieldwork/contracts also checks rules that link parts together: ids are unique within each list; every myth, entry, reason and villager that is referred to exists; every heart entry exists."
}
