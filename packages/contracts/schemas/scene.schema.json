{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*\\.\\.).+\\.glb$"
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "rotationYDeg": {
            "type": "number"
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "uri",
          "position",
          "rotationYDeg",
          "scale"
        ],
        "additionalProperties": false
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "fovDeg": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "rail": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              },
              "lookAt": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "position",
              "lookAt"
            ],
            "additionalProperties": false
          }
        },
        "driftSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "fovDeg",
        "rail",
        "driftSeconds"
      ],
      "additionalProperties": false
    },
    "walk": {
      "type": "object",
      "properties": {
        "nodes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "id",
              "position"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "string",
                "minLength": 1
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "start": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nodes",
        "edges",
        "start"
      ],
      "additionalProperties": false
    },
    "hotspots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "person",
              "object",
              "exit"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "walkNode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "position",
          "radius",
          "walkNode"
        ],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "mark",
              "prop",
              "actor"
            ]
          },
          "position": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "rotationYDeg": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "kind",
          "position",
          "rotationYDeg",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "palette": {
      "type": "object",
      "properties": {
        "sky": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "fog": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "ground": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "water": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "structure": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "figure": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "shadow": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "mark": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "sky",
        "fog",
        "ground",
        "water",
        "structure",
        "figure",
        "accent",
        "shadow",
        "mark"
      ],
      "additionalProperties": false
    },
    "fog": {
      "type": "object",
      "properties": {
        "near": {
          "type": "number",
          "minimum": 0
        },
        "far": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "near",
        "far"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "models",
    "camera",
    "walk",
    "hotspots",
    "slots",
    "palette",
    "fog"
  ],
  "additionalProperties": false,
  "$id": "https://fieldwork.invalid/schemas/scene.schema.json",
  "title": "Fieldwork scene",
  "description": "One fixed, staged 3D location. Right-handed, Y up, metres, as in glTF. This schema checks shape only. The parser in @fieldwork/contracts also checks rules that link parts of a scene: ids are unique within each list; every walk edge, walk.start and hotspot walkNode names an existing walk node; fog.near is less than fog.far."
}
