{
  "name": "fieldwork",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "schemas": "pnpm --filter @fieldwork/contracts run schemas",
    "ai:try": "tsx packages/gateway/scripts/try.ts",
    "models": "pnpm --filter @fieldwork/make-models run models",
    "build": "pnpm --filter @fieldwork/client run build",
    "dev": "pnpm --filter @fieldwork/client run dev",
    "e2e": "pnpm --filter @fieldwork/client run e2e",
    "shots": "pnpm --filter @fieldwork/client run shots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
